---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import TreatmentCard from '../../components/TreatmentCard.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import Icon from '../../components/Icon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import Faq from '../../components/home/Faq.astro';
import { SITE, digits, whatsappLink } from '../../config';
import { TREATMENTS_LIST, type Treatment } from '../../data/treatments';
import { DOCTORS } from '../../data/doctors';
import { POSTS } from '../../data/blog';

export const getStaticPaths = (() =>
  TREATMENTS_LIST.map((treatment) => ({ params: { slug: treatment.slug }, props: { treatment } }))) satisfies GetStaticPaths;

interface Props {
  treatment: Treatment;
}

const { treatment: t } = Astro.props;

const toc = [
  { id: 'overview', label: 'Overview' },
  { id: 'symptoms', label: 'Symptoms' },
  { id: 'causes', label: 'Causes' },
  { id: 'treatment-options', label: 'Treatment options' },
  { id: 'recovery', label: 'Recovery' },
  { id: 'faq', label: 'FAQs' },
];

const others = TREATMENTS_LIST.filter((o) => o.slug !== t.slug).slice(0, 4);
const team = DOCTORS.filter((d) => d.photo).slice(0, 4);
const related = POSTS.filter((p) => p.treatmentSlug === t.slug);

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: `${t.name} treatment in Bengaluru`,
  about: { '@type': 'MedicalCondition', name: t.name, signOrSymptom: t.symptoms.map((s) => ({ '@type': 'MedicalSignOrSymptom', name: s })) },
  publisher: { '@type': 'Hospital', name: SITE.name, telephone: SITE.phone, address: SITE.address },
};
---

<Layout title={`${t.name} treatment in Bengaluru`} description={`${t.short} Private consultation with colorectal specialists at ${SITE.name}, BTM 2nd Stage.`}>
  <PageHero
    crumbs={[{ label: 'Treatments', href: '/treatments' }, { label: t.navLabel }]}
    eyebrow="Treatment"
    title={t.name}
    lead={t.short}
    image={t.image}
  >
    <a href="#book" class="btn btn-lg btn-primary">Book a consultation <Icon name="arrowRight" class="size-4" /></a>
    <a href={whatsappLink(`Hi, I need help with ${t.name.toLowerCase()}. I'd like to book an appointment.`)} target="_blank" rel="noopener" class="btn btn-lg btn-outline-light">
      <WhatsAppIcon class="size-5" /> Ask on WhatsApp
    </a>
  </PageHero>

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-14 xl:grid-cols-[16rem_minmax(0,1fr)_20rem]">
      <!-- On this page -->
      <aside class="hidden lg:block">
        <nav aria-label="On this page" class="sticky top-28">
          <p class="text-kicker text-brand-400">On this page</p>
          <ul class="mt-4 space-y-1 border-l border-brand-100">
            {
              toc.map((s) => (
                <li>
                  <a href={`#${s.id}`} class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm font-medium text-ink-900/70 transition hover:border-brand-500 hover:text-brand-700">
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <article class="min-w-0">
        <section id="overview">
          <SectionHeader eyebrow="Overview" title={`About ${t.name.toLowerCase()}`} />
          <div class="text-lead mt-6 space-y-4">{t.overview.map((p) => <p>{p}</p>)}</div>
        </section>

        <div class="mt-14 grid gap-5 md:grid-cols-2">
          <section id="symptoms" class="card bg-brand-50">
            <h2 class="heading-3">Common symptoms</h2>
            <ul class="mt-5 space-y-3">
              {
                t.symptoms.map((s) => (
                  <li class="text-body flex gap-3 sm:text-base">
                    <Icon name="check" class="mt-1 size-4 shrink-0 text-brand-600" />
                    {s}
                  </li>
                ))
              }
            </ul>
          </section>
          <section id="causes" class="card bg-cream-50 ring-1 ring-cream-100">
            <h2 class="heading-3">Common causes</h2>
            <ul class="mt-5 space-y-3">
              {
                t.causes.map((c) => (
                  <li class="text-body flex gap-3 sm:text-base">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-amber-500" />
                    {c}
                  </li>
                ))
              }
            </ul>
          </section>
        </div>

        <section id="treatment-options" class="mt-14">
          <SectionHeader
            eyebrow="Treatment options"
            title="How we can "
            highlight="help"
            lead="Your specialist will explain which option suits you after a private examination."
          />
          <ol class="mt-8 grid gap-4 sm:grid-cols-2">
            {
              t.options.map((o, i) => (
                <li class="card flex flex-col border border-brand-100 bg-white">
                  <span class="text-kicker text-brand-400">Option {String(i + 1).padStart(2, '0')}</span>
                  <h3 class="heading-4 mt-2">{o.name}</h3>
                  <p class="text-body mt-2">{o.text}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <section id="recovery" class="mt-14">
          <SectionHeader eyebrow="Recovery" title="What to expect " highlight="afterwards" />
          <ul class="mt-6 grid gap-3">
            {
              t.recovery.map((r) => (
                <li class="text-body flex gap-3 rounded-2xl bg-brand-50 px-5 py-4 sm:text-base">
                  <Icon name="smile" class="mt-0.5 size-5 shrink-0 text-brand-600" />
                  {r}
                </li>
              ))
            }
          </ul>
        </section>

        <aside class="mt-10 flex gap-4 rounded-3xl border border-amber-300 bg-cream-50 p-6" role="note">
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-amber-400 text-ink-900">
            <Icon name="shield" class="size-5" />
          </span>
          <div>
            <h2 class="heading-4">When to see a doctor</h2>
            <p class="text-body mt-1 sm:text-base">{t.whenToSee}</p>
            <a href={`tel:${digits(SITE.emergency)}`} class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:underline">
              <Icon name="phone" class="size-4" /> 24×7 Emergency: {SITE.emergency}
            </a>
          </div>
        </aside>
      </article>

      <!-- Booking card -->
      <aside class="lg:col-span-2 xl:col-span-1">
        <div class="card bg-ink-900 text-white sm:p-8 xl:sticky xl:top-28">
          <h2 class="heading-3">Talk to a specialist</h2>
          <p class="mt-2 text-sm text-white/70">Private, one-to-one consultation. Your details are only seen by our care team.</p>
          <div class="mt-6 grid gap-3">
            <a href="#book" class="btn btn-primary w-full">Book an appointment</a>
            <a href={`tel:${digits(SITE.phone)}`} class="btn btn-outline-light w-full"><Icon name="phone" class="size-4" /> Call {SITE.phone}</a>
          </div>
          <p class="mt-6 border-t border-white/10 pt-5 text-xs text-white/60">
            Mon to Sat {SITE.hours.weekdays} · Sun {SITE.hours.sunday}
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section bg-brand-50/60">
    <div class="container-x">
      <SectionHeader eyebrow="Your care team" title="Specialists who treat " highlight={t.name.toLowerCase()}>
        <a slot="action" href="/doctors" class="btn btn-outline">All doctors <Icon name="arrowRight" class="size-4" /></a>
      </SectionHeader>
      <ul class="section-body grid grid-cols-1 gap-5 min-[480px]:grid-cols-2 lg:grid-cols-4">
        {team.map((d) => <li><DoctorCard doctor={d} /></li>)}
      </ul>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section">
        <div class="container-x">
          <SectionHeader eyebrow="Read more" title="Related " highlight="articles" />
          <ul class="section-body grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <li>
                <a href={`/blog/${p.slug}`} class="card group flex h-full flex-col border border-brand-100 bg-white transition hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-200/40">
                  <span class="text-kicker text-brand-400">{p.tag} · {p.readMinutes} min read</span>
                  <h3 class="heading-4 mt-2 group-hover:text-brand-700">{p.title}</h3>
                  <p class="text-body mt-2">{p.excerpt}</p>
                  <span class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold text-brand-600">
                    Read article <Icon name="arrowRight" class="size-4" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Faq items={t.faqs} eyebrow="Common questions" title={`${t.name}: `} highlight="your questions answered" />

  <section class="section">
    <div class="container-x">
      <SectionHeader eyebrow="Other conditions" title="Other " highlight="treatments">
        <a slot="action" href="/treatments" class="btn btn-outline">All treatments <Icon name="arrowRight" class="size-4" /></a>
      </SectionHeader>
      <ul class="section-body grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((o) => <li><TreatmentCard treatment={o} /></li>)}
      </ul>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(pageLd)} />
</Layout>
