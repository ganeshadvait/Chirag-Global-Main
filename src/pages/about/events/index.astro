---
import Layout from '../../../layouts/Layout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import EventCard from '../../../components/EventCard.astro';
import Lightbox from '../../../components/Lightbox.astro';
import Icon from '../../../components/Icon.astro';
import WhatsAppIcon from '../../../components/WhatsAppIcon.astro';
import { whatsappLink } from '../../../config';
import { EVENTS, CATEGORY_ICONS, eventDay, formatEventDate, type EventCategory } from '../../../data/events';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About Us', href: '/about' }, { label: 'Events' }];

// Static build: "upcoming" is evaluated when the site is built.
const today = new Date().toISOString().slice(0, 10);
const upcoming = EVENTS.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const past = EVENTS.filter((e) => e.date < today);
const [featured, ...rest] = past;

const categories = [...new Set(EVENTS.map((e) => e.category))] as EventCategory[];
const years = [...new Set(rest.map((e) => eventDay(e.date).year))].sort((a, b) => b - a);

const photos = EVENTS.flatMap((e) => e.gallery.map((src) => ({ src, title: e.title })));
const photoCount = photos.length;
const collage = [EVENTS[4]?.cover, EVENTS[0]?.cover, EVENTS[5]?.cover].filter(Boolean) as string[];

const invite = [
  { icon: 'activity', title: 'Free health camps', text: 'Screening and consultations for your community or organisation.' },
  { icon: 'users', title: 'Awareness talks', text: 'Practical sessions on piles, constipation and digestive health.' },
  { icon: 'clipboard', title: 'Medical education', text: 'CME sessions and guest lectures for students and doctors.' },
] as const;
---

<Layout
  overlayHeader
  title="Events"
  description="Health camps, awareness talks, conferences and celebrations at Chirag Global Hospitals, Bengaluru."
>
  <!-- ============ HERO (matches home hero) ============ -->
  <section class="relative isolate overflow-hidden bg-ink-900 text-white">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -left-40 top-1/3 size-[32rem] rounded-full bg-brand-500/25 blur-3xl"></div>
      <div class="absolute -right-24 top-24 size-[30rem] rounded-full bg-brand-400/25 blur-3xl"></div>
    </div>

    <div class="container-x grid items-center gap-12 pb-40 pt-32 sm:pt-36 lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:pb-48 lg:pt-44 xl:pt-48">
      <div>
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-white/60">
            {
              crumbs.map((c, i) => (
                <li class="flex items-center gap-1.5">
                  {i > 0 && <Icon name="chevronRight" class="size-3.5 text-white/40" />}
                  {c.href ? <a href={c.href} class="transition hover:text-white">{c.label}</a> : <span aria-current="page" class="text-white/90">{c.label}</span>}
                </li>
              ))
            }
          </ol>
        </nav>
        <ul class="mt-6 flex flex-wrap gap-2 text-xs font-semibold sm:text-sm">
          <li class="btn-amber rounded-full px-3.5 py-1.5">Events</li>
          <li class="rounded-full border border-white/30 bg-ink-900/30 px-3.5 py-1.5 backdrop-blur-sm">Health camps</li>
          <li class="hidden rounded-full border border-white/30 bg-ink-900/30 px-3.5 py-1.5 backdrop-blur-sm sm:block">Conferences</li>
        </ul>
        <h1 class="heading-1 mt-5 max-w-2xl lg:mt-6">
          Care beyond <span class="text-amber-400">our hospital walls.</span>
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg lg:mt-6">
          Free health camps, awareness talks, medical conferences and celebrations: how our team shares knowledge and
          reaches people across Karnataka and beyond.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#all-events" class="btn btn-lg btn-primary">Browse events <Icon name="arrowRight" class="size-4" /></a>
          <a href="#invite" class="btn btn-lg btn-outline-light bg-ink-900/30 backdrop-blur-sm">Invite our team</a>
        </div>
      </div>

      <!-- Photo collage -->
      <div class="relative mx-auto aspect-[5/4] w-full max-w-xl">
        {
          collage.map((src, i) => (
            <div
              class:list={[
                'absolute overflow-hidden rounded-3xl shadow-2xl shadow-ink-950/50 ring-8 ring-white/10',
                i === 0 && 'left-0 top-[26%] w-[40%] -rotate-6 aspect-[3/4]',
                i === 1 && 'right-[4%] top-0 w-[58%] aspect-[4/3]',
                i === 2 && 'bottom-0 right-0 z-10 w-[50%] rotate-3 aspect-[4/3]',
              ]}
            >
              <img src={src} alt="" class="size-full object-cover" fetchpriority={i === 1 ? 'high' : undefined} />
            </div>
          ))
        }
        <div class="absolute bottom-[6%] left-[4%] z-20 flex items-center gap-3 rounded-2xl bg-white p-3 pr-5 text-ink-900 shadow-xl shadow-ink-950/40">
          <span class="btn-amber grid size-11 place-items-center rounded-xl"><Icon name="camera" class="size-5" /></span>
          <div>
            <p class="text-sm font-semibold">{photoCount} photos</p>
            <p class="text-meta">from {EVENTS.length} events</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Featured (latest) event, overlapping the hero edge ============ -->
  {
    featured && (
      <section class="relative z-10 -mt-24 lg:-mt-28" aria-labelledby="featured-title">
        <div class="container-x">
          <a
            href={`/about/events/${featured.slug}`}
            class="group grid overflow-hidden rounded-3xl bg-white text-ink-900 shadow-2xl shadow-ink-900/15 ring-1 ring-brand-100 lg:grid-cols-[1.15fr_1fr]"
          >
            <div class="relative aspect-[16/10] overflow-hidden lg:aspect-auto">
              <img src={featured.cover} alt="" class="size-full object-cover transition duration-500 group-hover:scale-105" />
              <span class="btn-amber absolute left-5 top-5 rounded-full px-3 py-1.5 text-xs font-semibold">Latest event</span>
            </div>
            <div class="flex flex-col p-6 sm:p-8 lg:p-10">
              <p class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600">
                <Icon name={CATEGORY_ICONS[featured.category]} class="size-4" />
                {featured.category} · {formatEventDate(featured)}
              </p>
              <h2 id="featured-title" class="heading-3 mt-3 group-hover:text-brand-700">{featured.title}</h2>
              <p class="text-body mt-3 sm:text-base">{featured.body[0]}</p>
              {featured.highlights && (
                <ul class="mt-5 space-y-2">
                  {featured.highlights.slice(0, 3).map((h) => (
                    <li class="text-body flex gap-2.5">
                      <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" />
                      {h}
                    </li>
                  ))}
                </ul>
              )}
              <span class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-brand-600">
                Read the full story <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
              </span>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <!-- ============ Upcoming ============ -->
  {
    upcoming.length > 0 && (
      <section class="section">
        <div class="container-x">
          <SectionHeader eyebrow="Coming up" title="Upcoming " highlight="events" />
          <ul class="section-body grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {upcoming.map((e) => <li><EventCard event={e} /></li>)}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ============ All events: filter + year groups ============ -->
  <section id="all-events" class="section" data-events>
    <div class="container-x">
      <SectionHeader eyebrow="Past events" title="Moments from " highlight="our journey" />

      <div role="group" aria-label="Filter events by type" class="no-scrollbar -mx-4 mt-8 flex gap-2 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0">
        <button type="button" data-filter="all" aria-pressed="true" class="filter-chip">All events</button>
        {
          categories.map((c) => (
            <button type="button" data-filter={c} aria-pressed="false" class="filter-chip">
              <Icon name={CATEGORY_ICONS[c]} class="size-4" />
              {c}
            </button>
          ))
        }
      </div>

      <div class="mt-10 space-y-12">
        {
          years.map((y) => (
            <div data-year-group>
              <div class="flex items-center gap-4">
                <h3 class="heading-3 text-brand-600">{y}</h3>
                <span class="h-px flex-1 bg-brand-100" />
              </div>
              <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {rest.filter((e) => eventDay(e.date).year === y).map((e) => (
                  <li data-category={e.category}>
                    <EventCard event={e} as="h4" />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <p data-empty hidden class="text-body rounded-2xl bg-brand-50 p-6 text-center">No other events of this type yet.</p>
      </div>
    </div>
  </section>

  <!-- ============ Photo wall ============ -->
  <section class="section bg-brand-50/60">
    <div class="container-x">
      <SectionHeader eyebrow="Gallery" title="Photo " highlight="gallery" lead="Select a photo to view it full size." />
      <ul class="section-body columns-2 gap-3 sm:columns-3 lg:columns-4 [&>li]:mb-3">
        {
          photos.map((p, i) => (
            <li class="break-inside-avoid">
              <a href={p.src} data-lightbox="all-events" aria-label={`Photo ${i + 1}: ${p.title}`} class="group block overflow-hidden rounded-2xl bg-brand-100">
                <img src={p.src} alt={p.title} loading="lazy" class="w-full transition duration-500 group-hover:scale-105" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Invite our team ============ -->
  <section id="invite" class="section">
    <div class="container-x">
      <div class="panel grid gap-8 bg-gradient-to-br from-brand-50 via-brand-100 to-brand-200/60 lg:grid-cols-[1fr_1.5fr] lg:items-center lg:gap-12">
        <div>
          <SectionHeader
            eyebrow="Work with us"
            eyebrowClass="bg-white/70"
            title="Invite our team to "
            highlight="your community"
            lead="We run free health camps, awareness talks and education sessions for workplaces, colleges, temples and community groups."
          />
          <a href={whatsappLink('Hi, I would like to invite Chirag Global Hospitals for a health camp or talk.')} target="_blank" rel="noopener" class="btn btn-lg btn-dark mt-8">
            <WhatsAppIcon class="size-5" /> Invite us on WhatsApp
          </a>
        </div>
        <ul class="grid gap-3 sm:grid-cols-3">
          {
            invite.map((v) => (
              <li class="rounded-2xl bg-white p-5 shadow-sm">
                <span class="grid size-11 place-items-center rounded-xl bg-ink-900 text-amber-400">
                  <Icon name={v.icon} class="size-5" />
                </span>
                <h3 class="heading-5 mt-4">{v.title}</h3>
                <p class="text-body mt-1">{v.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Lightbox />
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-events]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const groups = root.querySelectorAll<HTMLElement>('[data-year-group]');
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let shown = 0;
        groups.forEach((g) => {
          let n = 0;
          g.querySelectorAll<HTMLElement>('[data-category]').forEach((li) => {
            li.hidden = key !== 'all' && li.dataset.category !== key;
            if (!li.hidden) n++;
          });
          g.hidden = n === 0;
          shown += n;
        });
        empty.hidden = shown > 0;
      }),
    );
  });
</script>
