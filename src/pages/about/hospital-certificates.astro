---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Lightbox from '../../components/Lightbox.astro';
import Icon from '../../components/Icon.astro';
import { IMAGES } from '../../data/home';
import { CERTIFICATES, GROUPS, preview, pdf, type Certificate } from '../../data/certificates';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About Us', href: '/about' }, { label: 'Hospital Certificates' }];

const nabh = CERTIFICATES.find((c) => c.slug === 'nabh')!;
const kpme = CERTIFICATES.find((c) => c.slug === 'kpme-chirag-global')!;
const groups = GROUPS.filter((g) => g.key !== 'Accreditation').map((g) => ({
  ...g,
  items: CERTIFICATES.filter((c) => c.group === g.key),
}));

const facts = [
  { icon: 'shield', value: 'NABH', label: 'Entry Level certified' },
  { icon: 'clipboard', value: 'Level 3', label: 'Registered hospital (KPME)' },
  { icon: 'leaf', value: 'KSPCB', label: 'Bio-medical waste authorized' },
  { icon: 'file', value: '2026–27', label: 'Current BBMP trade licence' },
] as const;

const why = [
  { icon: 'shield', title: 'Safer care', text: 'Accreditation means our processes for safety, hygiene and infection control are checked against national standards.' },
  { icon: 'clipboard', title: 'Legally registered', text: 'Every service we offer, from surgery to ultrasound, is registered with the relevant government authority.' },
  { icon: 'leaf', title: 'Responsible disposal', text: 'Bio-medical waste is handed to an authorized facility and reported every year, protecting the community.' },
] as const;

const cardId = (c: Certificate) => `cert-${c.slug}`;
---

<Layout
  overlayHeader
  title="Hospital Certificates"
  description="NABH certification, KPME registration, PC-PNDT registration, bio-medical waste authorization and trade licences of Chirag Global Hospitals, Bengaluru."
>
  <!-- ============ HERO (matches home hero) ============ -->
  <section class="relative isolate overflow-hidden bg-ink-900 text-white">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -left-40 top-1/3 size-[32rem] rounded-full bg-brand-500/25 blur-3xl"></div>
      <div class="absolute -right-24 top-24 size-[30rem] rounded-full bg-brand-400/25 blur-3xl"></div>
    </div>

    <div class="container-x grid items-center gap-12 pb-40 pt-32 sm:pt-36 lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:pb-48 lg:pt-44 xl:pt-48">
      <div>
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-white/60">
            {
              crumbs.map((c, i) => (
                <li class="flex items-center gap-1.5">
                  {i > 0 && <Icon name="chevronRight" class="size-3.5 text-white/40" />}
                  {c.href ? <a href={c.href} class="transition hover:text-white">{c.label}</a> : <span aria-current="page" class="text-white/90">{c.label}</span>}
                </li>
              ))
            }
          </ol>
        </nav>
        <ul class="mt-6 flex flex-wrap gap-2 text-xs font-semibold sm:text-sm">
          <li class="btn-amber rounded-full px-3.5 py-1.5">NABH certified</li>
          <li class="rounded-full border border-white/30 bg-ink-900/30 px-3.5 py-1.5 backdrop-blur-sm">Government registered</li>
          <li class="hidden rounded-full border border-white/30 bg-ink-900/30 px-3.5 py-1.5 backdrop-blur-sm sm:block">{CERTIFICATES.length} documents</li>
        </ul>
        <h1 class="heading-1 mt-5 max-w-2xl lg:mt-6">
          Accredited, licensed and <span class="text-amber-400">accountable.</span>
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg lg:mt-6">
          Our accreditation, registrations and statutory documents, published in full so you can see the standards we
          are held to.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#documents" class="btn btn-lg btn-primary">View documents <Icon name="arrowRight" class="size-4" /></a>
          <a href={pdf(nabh)} target="_blank" rel="noopener" class="btn btn-lg btn-outline-light bg-ink-900/30 backdrop-blur-sm">
            <Icon name="file" class="size-4" /> NABH certificate (PDF)
          </a>
        </div>
      </div>

      <!-- Framed certificates -->
      <div class="relative mx-auto aspect-[5/4] w-full max-w-xl">
        <div class="absolute left-0 top-[12%] w-[44%] -rotate-6 overflow-hidden rounded-2xl bg-white p-2 shadow-2xl shadow-ink-950/50">
          <img src={preview(kpme)} alt="" class="aspect-[3/4] w-full rounded-lg object-cover object-top" />
        </div>
        <div class="absolute right-0 top-0 z-10 w-[78%] rotate-2 overflow-hidden rounded-2xl bg-white p-2.5 shadow-2xl shadow-ink-950/60">
          <img src={preview(nabh)} alt="NABH certificate of Chirag Global Hospitals" fetchpriority="high" class="w-full rounded-lg" />
        </div>
        <div class="absolute bottom-[4%] left-[6%] z-20 flex items-center gap-3 rounded-2xl bg-white p-3 pr-5 text-ink-900 shadow-xl shadow-ink-950/40">
          <img src={IMAGES.nabh} alt="" width="1024" height="717" class="h-11 w-auto" />
          <div>
            <p class="text-sm font-semibold">NABH certified</p>
            <p class="text-meta">Entry Level</p>
          </div>
        </div>
        <div class="absolute bottom-[14%] right-[2%] z-20 rounded-2xl bg-amber-400 px-4 py-3 text-ink-900 shadow-xl">
          <p class="text-xl font-extrabold leading-none">Level 3</p>
          <p class="mt-1 text-[11px] font-semibold">KPME registered</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick facts overlapping the hero edge -->
  <section class="relative z-10 -mt-24 lg:-mt-28" aria-label="At a glance">
    <div class="container-x">
      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-3xl bg-brand-100 shadow-2xl shadow-ink-900/10 ring-1 ring-brand-100 lg:grid-cols-4">
        {
          facts.map((f) => (
            <div class="flex items-center gap-4 bg-white p-5 sm:p-6">
              <span class="hidden size-12 shrink-0 place-items-center rounded-2xl bg-brand-50 text-brand-600 sm:grid">
                <Icon name={f.icon} class="size-6" />
              </span>
              <div>
                <dt class="sr-only">{f.label}</dt>
                <dd>
                  <span class="block text-2xl font-extrabold tracking-tight text-brand-600 sm:text-3xl">{f.value}</span>
                  <span class="text-xs text-ink-900/70 sm:text-sm">{f.label}</span>
                </dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============ Accreditation: NABH feature ============ -->
  <section class="section">
    <div class="container-x">
      <SectionHeader eyebrow="Accreditation" title="Certified for " highlight="quality and safety" />
      <article class="section-body grid items-center gap-8 overflow-hidden rounded-[2rem] bg-brand-50 p-6 ring-1 ring-brand-100 sm:p-10 lg:grid-cols-[1.2fr_1fr] lg:gap-12 lg:rounded-[2.5rem] lg:p-12">
        <a href={preview(nabh)} data-lightbox={nabh.slug} class="group relative block overflow-hidden rounded-2xl bg-white p-3 shadow-xl shadow-brand-300/40">
          <img src={preview(nabh)} alt={nabh.title} loading="lazy" class="w-full rounded-lg transition duration-500 group-hover:scale-[1.02]" />
          <span class="absolute bottom-5 right-5 inline-flex items-center gap-2 rounded-full bg-ink-900/85 px-3.5 py-2 text-xs font-semibold text-white backdrop-blur">
            <Icon name="search" class="size-3.5" /> Click to enlarge
          </span>
        </a>
        <div>
          <img src={IMAGES.nabh} alt="" width="1024" height="717" class="h-16 w-auto" />
          <h3 class="heading-3 mt-5">{nabh.title}</h3>
          <p class="text-meta mt-1">{nabh.issuer}</p>
          <p class="text-lead mt-4">{nabh.text}</p>
          <ul class="mt-6 space-y-2.5">
            {['Patient safety and rights', 'Infection control and hygiene', 'Quality of clinical care'].map((t) => (
              <li class="text-body flex gap-2.5 sm:text-base">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-brand-600" />{t}
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={preview(nabh)} data-lightbox={nabh.slug} class="btn btn-dark"><Icon name="eye" class="size-4" /> View certificate</a>
            <a href={pdf(nabh)} target="_blank" rel="noopener" class="btn btn-outline"><Icon name="file" class="size-4" /> Download PDF</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ============ All documents by group ============ -->
  <section id="documents" class="section bg-brand-50/60" data-certs>
    <div class="container-x">
      <SectionHeader
        eyebrow="Documents"
        title="Registrations and "
        highlight="statutory compliance"
        lead="Select any document to view it full size, or open the original PDF."
      />

      <div role="group" aria-label="Filter documents" class="no-scrollbar -mx-4 mt-8 flex gap-2 overflow-x-auto px-4 sm:mx-0 sm:flex-wrap sm:px-0">
        <button type="button" data-filter="all" aria-pressed="true" class="filter-chip">All documents</button>
        {
          groups.map((g) => (
            <button type="button" data-filter={g.key} aria-pressed="false" class="filter-chip">
              <Icon name={g.icon} class="size-4" />
              {g.key}
            </button>
          ))
        }
      </div>

      <div class="mt-10 space-y-14">
        {
          groups.map((g) => (
            <div data-group={g.key}>
              <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
                <div class="flex items-center gap-3">
                  <span class="grid size-10 place-items-center rounded-xl bg-ink-900 text-amber-400">
                    <Icon name={g.icon} class="size-5" />
                  </span>
                  <h3 class="heading-3">{g.key}</h3>
                </div>
                <p class="text-body">{g.text}</p>
              </div>

              <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {g.items.map((c) => (
                  <li id={cardId(c)}>
                    <article class="group flex h-full flex-col rounded-3xl bg-white p-4 ring-1 ring-brand-100 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-200/50">
                      <a
                        href={preview(c)}
                        data-lightbox={c.slug}
                        aria-label={`View ${c.title}`}
                        class="relative block aspect-[4/3] overflow-hidden rounded-2xl bg-gradient-to-b from-brand-100 to-brand-50"
                      >
                        <img
                          src={preview(c)}
                          alt={c.title}
                          loading="lazy"
                          class="absolute left-1/2 top-5 w-[78%] -translate-x-1/2 rounded-md bg-white shadow-lg shadow-brand-300/50 transition duration-500 group-hover:-translate-y-1"
                        />
                        <span class="absolute right-3 top-3 grid size-9 place-items-center rounded-full bg-white text-ink-900 opacity-0 shadow transition group-hover:opacity-100">
                          <Icon name="search" class="size-4" />
                        </span>
                        {c.pages && (
                          <span class="absolute bottom-3 left-3 rounded-full bg-ink-900/85 px-3 py-1 text-xs font-semibold text-white">
                            {c.pages.length + 1} pages
                          </span>
                        )}
                      </a>
                      {c.pages?.map((p, n) => (
                        <a href={p} data-lightbox={c.slug} class="hidden" aria-label={`${c.title}, page ${n + 2}`} />
                      ))}

                      <div class="flex flex-1 flex-col px-2 pb-2 pt-5">
                        <h4 class="heading-4">{c.title}</h4>
                        <p class="text-meta mt-1">{c.issuer}</p>
                        <dl class="mt-4 space-y-1.5 border-t border-brand-100 pt-4">
                          {c.details.map((d) => (
                            <div class="flex justify-between gap-4 text-sm">
                              <dt class="text-ink-900/60">{d.label}</dt>
                              <dd class="text-right font-semibold">{d.value}</dd>
                            </div>
                          ))}
                        </dl>
                        <p class="text-body mt-4">{c.text}</p>
                        <div class="mt-auto flex gap-2 pt-5">
                          <a href={preview(c)} data-lightbox={c.slug} class="btn btn-dark flex-1 px-4 py-2.5">
                            <Icon name="eye" class="size-4" /> View
                          </a>
                          <a href={pdf(c)} target="_blank" rel="noopener" class="btn btn-outline flex-1 px-4 py-2.5" aria-label={`Download ${c.title} (PDF)`}>
                            <Icon name="file" class="size-4" /> PDF
                          </a>
                        </div>
                      </div>
                    </article>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Why it matters ============ -->
  <section class="section">
    <div class="container-x">
      <SectionHeader align="center" eyebrow="For patients" title="Why these documents " highlight="matter to you" />
      <ul class="section-body grid gap-5 md:grid-cols-3">
        {
          why.map((w) => (
            <li class="card bg-white shadow-lg shadow-brand-200/30 ring-1 ring-brand-100">
              <span class="grid size-12 place-items-center rounded-2xl bg-amber-400 text-ink-900">
                <Icon name={w.icon} class="size-6" />
              </span>
              <h3 class="heading-4 mt-5">{w.title}</h3>
              <p class="text-body mt-2 sm:text-base">{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Lightbox />
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-certs]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const groups = root.querySelectorAll<HTMLElement>('[data-group]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        groups.forEach((g) => (g.hidden = key !== 'all' && g.dataset.group !== key));
      }),
    );
  });
</script>
