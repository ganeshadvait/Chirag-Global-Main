---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const links = [
  { href: '/treatments', label: 'Treatments' },
  { href: '/doctors', label: 'Our Doctors' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact Us' },
];
---

<Layout title="Page not found" booking={false}>
  <section class="relative isolate overflow-hidden bg-ink-900 text-white">
    <div aria-hidden="true" class="absolute -left-40 -top-20 -z-10 size-[30rem] rounded-full bg-brand-500/30 blur-3xl"></div>
    <div class="container-x py-20 text-center sm:py-28">
      <p class="text-8xl font-black tracking-tight text-amber-400 sm:text-9xl">404</p>
      <h1 class="heading-1 mt-4">Page not found</h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg">
        Sorry, we couldn't find that page. It may have moved, or the link may be out of date.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-lg btn-primary">Back to home <Icon name="arrowRight" class="size-4" /></a>
        <a href="/contact" class="btn btn-lg btn-outline-light">Contact us</a>
      </div>
      <ul class="mt-12 flex flex-wrap justify-center gap-2">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="rounded-full border border-white/20 px-4 py-2 text-sm text-white/80 transition hover:bg-white/10 hover:text-white">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
