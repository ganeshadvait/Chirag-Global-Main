---
import type { GetStaticPaths } from 'astro';
import { treatmentHref } from '../lib/routes';

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import { SITE, digits } from '../config';
import { POSTS, formatDate, type BlogPost } from '../data/blog';
import { getTreatment } from '../data/treatments';
import { publicFileExists } from '../lib/assets';

export const getStaticPaths = (() => POSTS.map((post) => ({ params: { post: post.slug }, props: { post } }))) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
}

const { post: p } = Astro.props;
const treatment = getTreatment(p.treatmentSlug);
const hasCover = publicFileExists(p.image);
const updated = p.modified.slice(0, 10) > p.date.slice(0, 10);

// Three more articles: same topic first, then the latest
const others = POSTS.filter((o) => o.slug !== p.slug);
const more = [...others.filter((o) => o.tag === p.tag), ...others.filter((o) => o.tag !== p.tag)].slice(0, 3);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: p.title,
  description: p.excerpt,
  datePublished: p.date,
  dateModified: p.modified,
  ...(hasCover && { image: new URL(p.image, Astro.site ?? Astro.url).href }),
  publisher: { '@type': 'Hospital', name: SITE.name },
};
---

<Layout title={p.title} description={p.excerpt}>
  <PageHero crumbs={[{ label: 'Blog', href: '/health-updates-2' }, { label: p.title }]} eyebrow={p.tag} title={p.title} lead={p.excerpt}>
    <span class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-white/70">
      <span class="inline-flex items-center gap-2">
        <Icon name="calendar" class="size-4 text-amber-400" />
        <time datetime={p.date}>{formatDate(p.date)}</time>
        {updated && <span>(updated <time datetime={p.modified}>{formatDate(p.modified)}</time>)</span>}
      </span>
      <span class="inline-flex items-center gap-2">
        <Icon name="clock" class="size-4 text-amber-400" />
        {p.readMinutes} min read
      </span>
    </span>
  </PageHero>

  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
      <article class="min-w-0 max-w-3xl">
        {
          hasCover && (
            <div class="relative mb-10 aspect-[3/2] overflow-hidden rounded-3xl bg-brand-100">
              <img decoding="async" src={p.image} alt={p.imageAlt} width="800" height="533" class="size-full object-cover" onerror="this.parentElement.remove()" />
            </div>
          )
        }

        <div class="article-body" set:html={p.html} />

        <p class="text-meta mt-12 border-t border-brand-100 pt-6">
          This article is for general information and is not a substitute for medical advice. Please consult a specialist
          about your symptoms. <a href="/medical-disclaimer" class="underline hover:text-brand-700">Medical disclaimer</a>
        </p>
      </article>

      <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
        {
          p.headings.length > 1 && (
            <nav aria-label="In this article" class="card hidden max-h-[calc(100vh-24rem)] overflow-y-auto border border-brand-100 bg-white [scrollbar-width:thin] lg:block">
              <p class="text-kicker text-brand-400">In this article</p>
              <ul class="mt-3 space-y-1">
                {p.headings.map((h) => (
                  <li>
                    <a href={`#${h.id}`} class="block py-1 text-sm font-medium text-ink-900/70 transition hover:text-brand-700">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        {
          treatment && (
            <a href={treatmentHref(treatment.slug)} class="card group block bg-brand-50 transition hover:bg-brand-100">
              <h2 class="text-kicker text-brand-400">Related treatment</h2>
              <p class="heading-4 mt-2">{treatment.name}</p>
              <p class="text-body mt-1">{treatment.short}</p>
              <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-brand-600">
                Learn more <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
              </span>
            </a>
          )
        }

        <div class="card bg-ink-900 text-white">
          <h2 class="heading-4">Worried about your symptoms?</h2>
          <p class="mt-2 text-sm text-white/70">Book a private, one-to-one consultation with our specialists.</p>
          <div class="mt-5 grid gap-3">
            <a href="#book" class="btn btn-primary w-full">Book an appointment</a>
            <a href={`tel:${digits(SITE.phone)}`} class="btn btn-outline-light w-full"><Icon name="phone" class="size-4" /> Call {SITE.phone}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {
    more.length > 0 && (
      <section class="section bg-brand-50/60">
        <div class="container-x">
          <SectionHeader eyebrow="Keep reading" title="More " highlight="articles">
            <a slot="action" href="/health-updates-2" class="btn btn-outline">All articles <Icon name="arrowRight" class="size-4" /></a>
          </SectionHeader>
          <ul class="section-body grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {more.map((o, i) => <li><ArticleCard post={o} index={i + 1} /></li>)}
          </ul>
        </div>
      </section>
    )
  }

  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
</Layout>
