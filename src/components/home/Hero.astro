---
import { altFor } from '../../data/image-alts';
import Icon from '../Icon.astro';
import { IMAGES, STATS } from '../../data/home';

const avatars = ['RM', 'SK', 'JV', 'PB'];
const DOCTORS_ON_TEAM = 9;
---

<section id="hero" aria-labelledby="hero-title" class="relative isolate overflow-hidden bg-ink-900 text-white">
  <!--
    Team photo, always at its natural ratio so the whole team stays in frame.
    Mobile/tablet: full-width band just below the floating header.
    Desktop: right-aligned beside the headline.
  -->
  <div
    class="hero-photo absolute inset-x-0 top-16 -z-10 aspect-[1600/815] sm:top-[4.5rem] lg:inset-x-auto lg:bottom-20 lg:right-0 lg:top-auto lg:w-[78%] xl:bottom-16 xl:w-[72%]"
  >
    <img decoding="async"
      src={IMAGES.hero}
      srcset={`${IMAGES.heroSmall} 900w, ${IMAGES.hero} 1600w`}
      sizes="(min-width: 1280px) 72vw, (min-width: 1024px) 78vw, 100vw"
      alt={altFor(IMAGES.hero, 'The Chirag Global Hospitals team of doctors')}
      width="1600"
      height="815"
      fetchpriority="high"
      class="size-full object-cover"
    />
    <!-- Brand tint; on desktop the edges are faded out with a mask (see .hero-photo) -->
    <div class="absolute inset-0 bg-gradient-to-b from-ink-900/25 via-transparent via-60% to-ink-900 lg:hidden"></div>
    <div class="absolute inset-0 hidden bg-ink-900/25 lg:block"></div>
    <div class="absolute inset-0 bg-brand-700/20 mix-blend-multiply"></div>
  </div>
  <div aria-hidden="true" class="absolute -left-40 top-1/3 -z-10 size-[32rem] rounded-full bg-brand-500/25 blur-3xl"></div>

  <div
    class="container-x relative pb-28 pt-[calc(51vw+2rem)] sm:pb-32 sm:pt-[calc(51vw+1.5rem)] lg:pb-32 lg:pt-44 xl:pt-48"
  >
    <ul class="flex flex-wrap gap-2 text-xs font-semibold sm:text-sm">
      <li class="btn-amber rounded-full px-3.5 py-1.5">Since 1986</li>
      <li class="rounded-full border border-white/30 bg-ink-900/30 px-3.5 py-1.5 backdrop-blur-sm">Private consultation</li>
      <li class="hidden rounded-full border border-white/30 bg-ink-900/30 px-3.5 py-1.5 backdrop-blur-sm sm:block">
        Women surgeons available
      </li>
    </ul>

    <h1
      id="hero-title"
      class="heading-1 mt-5 max-w-3xl lg:mt-6 lg:text-[3.5rem]"
    >
      Best Proctology Hospital<br class="hidden sm:inline" /> for Advanced Care{' '}<br class="hidden sm:inline" /><span class="text-amber-400">in Bangalore</span>
    </h1>

    <p class="mt-5 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg lg:mt-6">
      38+ years of trusted proctology care in Bangalore. One expert team for piles, fissure, fistula and complex
      colorectal conditions, with a clear diagnosis before any decision.
    </p>

    <div class="mt-8 hidden gap-4 sm:flex">
      <a
        href="#book"
        class="btn btn-lg btn-primary"
      >
        Book Appointment <Icon name="arrowRight" class="size-4" />
      </a>
      <a
        href="#treatments"
        class="btn btn-lg btn-outline-light bg-ink-900/30 backdrop-blur-sm"
      >
        Check your symptoms
      </a>
    </div>

    <!-- Team card -->
    <div
      class="mt-8 flex max-w-xl flex-col items-start gap-3 rounded-3xl min-[360px]:flex-row min-[360px]:items-center min-[360px]:gap-4 border border-white/15 bg-ink-900/55 p-4 backdrop-blur-md sm:gap-5 sm:px-6 xl:absolute xl:bottom-32 xl:right-10 xl:mt-0 xl:max-w-none"
    >
      <div class="flex shrink-0 -space-x-2.5">
        {
          avatars.map((a, i) => (
            <span
              class:list={[
                'grid size-10 place-items-center rounded-full border-2 border-ink-900 text-xs font-semibold text-ink-900 sm:size-12 sm:text-sm',
                i % 2 ? 'bg-brand-100' : 'bg-cream-100',
              ]}
            >
              {a}
            </span>
          ))
        }
        <span class="btn-amber grid size-10 place-items-center rounded-full border-2 border-ink-900 text-xs font-semibold sm:size-12 sm:text-sm">
          +{DOCTORS_ON_TEAM - avatars.length}
        </span>
      </div>
      <div>
        <p class="font-semibold sm:text-lg">{DOCTORS_ON_TEAM} specialists. One team.</p>
        <p class="text-xs text-white/75 sm:text-sm">Colorectal surgeons, proctologists and anaesthesiologists</p>
      </div>
    </div>
  </div>
</section>

<!-- Key facts, in a card overlapping the hero's flat bottom edge -->
<section aria-labelledby="facts-title" class="relative z-10 -mt-20 sm:-mt-24 lg:-mt-16">
  <div class="container-x">
    <h2 id="facts-title" class="sr-only">Chirag Global Hospitals at a glance</h2>
    <dl class="grid grid-cols-2 gap-y-6 rounded-3xl bg-white px-5 py-6 text-ink-900 shadow-2xl shadow-ink-900/15 ring-1 ring-brand-100 sm:px-8 sm:py-7 lg:grid-cols-4 lg:px-10">
      {
        STATS.map((s, i) => (
          <div
            class:list={[
              'px-1 sm:px-4',
              i % 2 === 1 && 'border-l border-brand-200 pl-5 sm:pl-6',
              i > 0 && 'lg:border-l lg:border-brand-200 lg:pl-8',
              i === 0 && 'lg:pl-0',
            ]}
          >
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class="text-3xl font-black tracking-tight text-brand-600 sm:text-4xl">{s.value}</span>
              {s.suffix && <span class="ml-1 text-xl text-amber-500">{s.suffix}</span>}
              <span class="mt-1 block text-xs text-ink-900/70 sm:text-sm">{s.label}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
