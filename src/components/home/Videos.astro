---
import { altFor } from '../../data/image-alts';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { SITE } from '../../config';
import { VIDEOS } from '../../data/home';

interface Props {
  /** How many talks to list (all when omitted) */
  limit?: number;
}

const { limit } = Astro.props;
const videos = limit ? VIDEOS.slice(0, limit) : VIDEOS;
// Talks left out of a shortened list, previewed in the "See all" card
const more = VIDEOS.slice(videos.length);
const [first] = videos;
const watchUrl = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---

{
  first && (
    <section id="videos" class="section">
      <div class="container-x" data-videos>
        <SectionHeader
          eyebrow="Doctor talks"
          title="Hear It from Our "
          highlight="Specialists"
          lead="Short videos where our doctors explain common problems in simple language."
        >
          <a slot="action" href={SITE.social.youtube} target="_blank" rel="noopener" class="btn btn-outline">
            Our YouTube channel <Icon name="arrowRight" class="size-4" />
          </a>
        </SectionHeader>

        <div class="section-body grid gap-5 lg:grid-cols-[1.75fr_1fr]">
          <!-- Player: thumbnail until play is pressed, so YouTube loads only on demand -->
          <article class="overflow-hidden rounded-3xl bg-ink-900 text-white" data-player>
            <div class="relative aspect-video bg-ink-800">
              <button type="button" class="group absolute inset-0 cursor-pointer" aria-label={`Play video: ${first.fullTitle}`} data-video-play>
                <img
                  src={first.thumb}
                  srcset={`${first.thumbSmall} 256w, ${first.thumb} 960w`}
                  sizes="(min-width: 1024px) 60vw, 100vw"
                  alt={altFor(first.thumb, first.title)}
                  width="960"
                  height="540"
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover"
                  data-video-thumb
                />
                <span aria-hidden="true" class="absolute inset-0 bg-ink-900/10 transition group-hover:bg-ink-900/25" />
                <span class="absolute inset-0 grid place-items-center">
                  <span class="grid size-16 place-items-center rounded-full bg-white text-ink-900 shadow-xl ring-8 ring-white/25 transition duration-300 group-hover:scale-110 group-hover:bg-amber-400 group-active:scale-95 sm:size-20">
                    <Icon name="play" class="ml-1 size-6 sm:size-7" />
                  </span>
                </span>
              </button>
              <div class="absolute inset-0 hidden bg-black" data-video-frame />
            </div>

            <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-end sm:justify-between sm:gap-6 sm:p-6" data-video-info>
              <div class="min-w-0">
                <span class="btn-amber text-kicker inline-block rounded-full px-3 py-1" data-video-tag>{first.tag}</span>
                <h3 class="heading-4 mt-3 line-clamp-2 text-balance" data-video-title>{first.title}</h3>
                <p class="mt-1.5 text-sm text-white/70" data-video-meta>{first.speaker} · {first.duration}</p>
              </div>
              <a
                href={watchUrl(first.youtubeId)}
                target="_blank"
                rel="noopener"
                class="inline-flex shrink-0 items-center gap-2 self-start whitespace-nowrap rounded-full border border-white/25 px-4 py-2 text-sm font-semibold transition hover:bg-white/10 sm:self-auto"
                data-video-link
              >
                <Icon name="youtube" class="size-4" /> Watch on YouTube
              </a>
            </div>
          </article>

          <!-- Playlist: as tall as the player on large screens; the list scrolls when longer,
               and a shortened list ends with a card linking to every talk -->
          <div class="relative">
            <div class="flex flex-col gap-3 lg:absolute lg:inset-0">
            <ul
              class="flex max-h-[26rem] min-h-0 flex-col gap-2 overflow-y-auto overscroll-contain pr-1.5 [scrollbar-color:var(--color-brand-200)_transparent] [scrollbar-width:thin] lg:max-h-none"
              aria-label="Doctor talk videos"
              data-video-list
            >
              {
                videos.map((v, i) => (
                  <li>
                    <button
                      type="button"
                      data-video={i}
                      aria-pressed={i === 0 ? 'true' : 'false'}
                      title={v.fullTitle}
                      class="group relative flex w-full cursor-pointer items-center gap-3 rounded-xl border border-brand-100 bg-white p-1.5 text-left outline-none transition duration-200 [-webkit-tap-highlight-color:transparent] hover:border-brand-300 hover:bg-brand-50/60 focus-visible:ring-2 focus-visible:ring-amber-400 active:scale-[0.98] aria-pressed:border-brand-300 aria-pressed:bg-brand-50"
                    >
                      <span class="relative aspect-video w-28 shrink-0 overflow-hidden rounded-lg bg-brand-100">
                        <img src={v.thumbSmall} alt={altFor(v.thumbSmall, v.title)} width="256" height="144" loading="lazy" decoding="async" class="size-full object-cover" />
                        <span class="absolute bottom-1 right-1 rounded bg-ink-900/85 px-1 text-[0.625rem] font-semibold leading-4 text-white">{v.duration}</span>
                        <!-- "Playing" overlay on the selected video -->
                        <span class="absolute inset-0 hidden place-items-center bg-ink-900/55 group-aria-pressed:grid">
                          <span class="grid size-7 place-items-center rounded-full bg-amber-400 text-ink-900">
                            <Icon name="play" class="ml-0.5 size-3" />
                          </span>
                        </span>
                      </span>
                      <span class="min-w-0">
                        <span class="line-clamp-2 text-[0.8125rem] font-semibold leading-snug text-ink-900 transition-colors group-hover:text-brand-700 group-aria-pressed:text-brand-700">{v.title}</span>
                        <span class="text-meta mt-1 line-clamp-1">{v.speaker}</span>
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
            {
              more.length > 0 && (
                <a
                  href="/educational-videos"
                  class="group flex flex-1 flex-col justify-between gap-4 rounded-2xl bg-brand-50 p-5 ring-1 ring-brand-100 transition hover:bg-brand-100/70 hover:ring-brand-200 sm:mr-1.5 xl:gap-5 xl:p-6"
                >
                  <!-- Full card on wide screens; on narrower desktops only the title and link fit beside the player -->
                  <div>
                    <p class="text-kicker text-brand-500">More doctor talks</p>
                    <p class="mt-2 text-[0.9375rem] font-semibold leading-snug text-balance xl:text-lg">
                      {VIDEOS.length} short videos on piles, fissure, fistula and recovery
                    </p>
                    <p class="text-body mt-2 max-lg:block lg:hidden xl:block">
                      Our specialists explain each condition, its treatment and what to expect afterwards.
                    </p>
                  </div>
                  <div class="flex items-center justify-between gap-4">
                    <span class="flex items-center max-lg:flex lg:hidden xl:flex">
                      {more.slice(0, 3).map((v) => (
                        <img
                          src={v.thumbSmall}
                          alt={altFor(v.thumbSmall, v.title)}
                          width="256"
                          height="144"
                          loading="lazy"
                          decoding="async"
                          class="-ml-4 aspect-video w-20 rounded-lg object-cover ring-2 ring-brand-50 first:ml-0"
                        />
                      ))}
                      {more.length > 3 && (
                        <span class="-ml-4 grid aspect-video w-20 place-items-center rounded-lg bg-ink-900 text-xs font-semibold text-white ring-2 ring-brand-50">
                          +{more.length - 3}
                        </span>
                      )}
                    </span>
                    <span class="inline-flex items-center gap-1.5 whitespace-nowrap text-sm font-semibold text-brand-700">
                      See all <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
                    </span>
                  </div>
                </a>
              )
            }
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<script is:inline define:vars={{ videos }}>
  const root = document.querySelector('[data-videos]');
  if (root) {
    const items = root.querySelectorAll('[data-video]');
    const player = root.querySelector('[data-player]');
    const frame = root.querySelector('[data-video-frame]');
    const play = root.querySelector('[data-video-play]');
    const thumb = root.querySelector('[data-video-thumb]');
    const link = root.querySelector('[data-video-link]');
    const info = root.querySelector('[data-video-info]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stacked = window.matchMedia('(max-width: 1023px)');
    let current = 0;

    // Fade the bottom of the playlist while more videos are hidden below
    const list = root.querySelector('[data-video-list]');
    const fade = () => {
      const more = list.scrollTop + list.clientHeight < list.scrollHeight - 4;
      list.style.maskImage = more ? 'linear-gradient(to bottom, #000 85%, transparent)' : '';
    };
    list.addEventListener('scroll', fade, { passive: true });
    new ResizeObserver(fade).observe(list);

    const set =(sel, text) => (root.querySelector(sel).textContent = text);

    items.forEach((btn) =>
      btn.addEventListener('click', () => {
        if (btn.getAttribute('aria-pressed') === 'true') return;
        current = Number(btn.dataset.video);
        const v = videos[current];
        items.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        set('[data-video-tag]', v.tag);
        set('[data-video-title]', v.title);
        set('[data-video-meta]', `${v.speaker} · ${v.duration}`);
        thumb.srcset = `${v.thumbSmall} 256w, ${v.thumb} 960w`;
        thumb.src = v.thumb;
        // Decorative: the play button already names the video
        thumb.alt = '';
        thumb.removeAttribute('title');
        link.href = `https://www.youtube.com/watch?v=${v.youtubeId}`;
        play.setAttribute('aria-label', `Play video: ${v.fullTitle}`);
        frame.classList.add('hidden');
        frame.replaceChildren();
        if (!reduceMotion) {
          info.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 300, easing: 'ease-out' });
        }
        // When the list sits below the player, bring the player back into view
        if (stacked.matches) player.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest' });
      }),
    );

    // YouTube loads only once the visitor presses play (privacy-enhanced mode)
    play.addEventListener('click', () => {
      const v = videos[current];
      const iframe = document.createElement('iframe');
      iframe.className = 'size-full';
      iframe.src = `https://www.youtube-nocookie.com/embed/${v.youtubeId}?autoplay=1&rel=0`;
      iframe.title = v.fullTitle;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      frame.classList.remove('hidden');
    });
  }
</script>
