---
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { getTreatment, TREATMENTS_LIST, type Treatment } from '../../data/treatments';

// Highlighted conditions (with photos); the rest show as chips in "Also treated"
const featuredSlugs = ['piles-hemorrhoids', 'fissure', 'fistula', 'pilonidal-sinus'];
const [featured, ...rest] = featuredSlugs.map((s) => getTreatment(s)) as Treatment[];
const also = TREATMENTS_LIST.filter((t) => !featuredSlugs.includes(t.slug));
---

<section id="treatments" class="section">
  <div class="container-x">
    <SectionHeader eyebrow="Our treatments" title="Specialist care for every" highlight=" anorectal condition.">
      <a slot="action" href="/treatments" class="btn btn-outline">
        All treatments <Icon name="arrowRight" class="size-4" />
      </a>
    </SectionHeader>

    <div class="section-body grid gap-4 md:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1fr] lg:gap-5">
      <!-- Featured -->
      <article
        class="group relative flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-3xl bg-gradient-to-br from-brand-400 to-ink-800 p-4 md:row-span-2 lg:min-h-[32rem]"
      >
        <img
          src={featured.image}
          alt=""
          width="662"
          height="507"
          loading="lazy"
          class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
          onerror="this.remove()"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink-900/50 via-transparent to-transparent"></div>
        <span class="text-kicker absolute left-5 top-5 rounded-full bg-ink-900 px-3 py-1.5 text-amber-400">Most treated</span>
        <div class="relative flex items-end gap-4 rounded-2xl bg-white/95 p-5 backdrop-blur sm:p-6">
          <div>
            <h3 class="heading-3">{featured.name}</h3>
            <p class="text-body mt-2">{featured.short}</p>
          </div>
          <a
            href={`/treatments/${featured.slug}`}
            aria-label={`Learn about ${featured.name}`}
            class="grid size-11 shrink-0 place-items-center rounded-full bg-ink-900 text-white transition hover:bg-brand-600"
          >
            <Icon name="arrowRight" class="size-4" />
          </a>
        </div>
      </article>

      {
        rest.map((t, i) => (
          <a
            href={`/treatments/${t.slug}`}
            class="group relative flex min-h-64 flex-col justify-end overflow-hidden rounded-3xl bg-gradient-to-br from-brand-400 to-ink-800 p-5 text-white sm:p-6"
          >
            <img
              src={t.image}
              alt=""
              width="662"
              height="507"
              loading="lazy"
              class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
              onerror="this.remove()"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/90 via-ink-900/35 to-transparent" />
            <div class="absolute inset-x-5 top-5 flex items-center justify-between sm:inset-x-6">
              <span class="text-kicker rounded-full bg-white/90 px-2.5 py-1 text-ink-900">{String(i + 2).padStart(2, '0')}</span>
              <span class="grid size-9 place-items-center rounded-full bg-white text-ink-900 transition group-hover:bg-amber-400">
                <Icon name="arrowRight" class="size-4" />
              </span>
            </div>
            <div class="relative">
              <h3 class="heading-4 text-white">{t.name}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-white/80">{t.short}</p>
            </div>
          </a>
        ))
      }

      <div class="card flex flex-col bg-ink-900 text-white">
        <h3 class="heading-4">Also treated</h3>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            also.map((t, i) => (
              <li>
                <a
                  href={`/treatments/${t.slug}`}
                  class:list={[
                    'block rounded-full px-3.5 py-2 text-xs font-medium transition',
                    i === also.length - 1 ? 'btn-amber hover:brightness-105' : 'border border-white/30 hover:bg-white/10',
                  ]}
                >
                  {t.name}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-auto pt-6">
          <a href="/treatments" class="btn btn-outline-light">
            See all conditions <Icon name="arrowRight" class="size-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
