---
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import ArticleCard from '../ArticleCard.astro';
import { POSTS } from '../../data/blog';
---

<section id="articles" class="section">
  <div class="container-x">
    <SectionHeader eyebrow="Health tips and news" title="Stay informed with " highlight="expert articles">
      <a slot="action" href="/blog" class="btn btn-outline">
        Read the blog <Icon name="arrowRight" class="size-4" />
      </a>
    </SectionHeader>

    <ul class="section-body no-scrollbar -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0">
      {
        POSTS.slice(0, 3).map((p, i) => (
          <li class="w-[80%] shrink-0 snap-start sm:w-[60%] md:w-auto">
            <ArticleCard post={p} index={i} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
