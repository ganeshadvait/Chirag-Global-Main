---
import { altFor } from '../../data/image-alts';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { SITE } from '../../config';
import { INTERNATIONAL } from '../../data/home';

const [first] = INTERNATIONAL;
---

<section id="international" class="section">
  <div class="container-x">
    <div class="panel relative isolate overflow-hidden bg-brand-100/70" data-intl>
      <!--
        Background: world map with a plane flying to Bangalore. Landscape video from 768px,
        portrait below. Blended into the lavender panel (white becomes the panel colour, the map
        shows faintly). Loaded only when the section is near the screen, paused off screen, and
        left on its still first frame for visitors who prefer reduced motion.
      -->
      <video
        data-intl-video
        data-src-wide="/videos/world-map-bg-video.webm"
        data-src-tall="/videos/world-map-mobile-bg-video.webm"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        disableremoteplayback
        aria-hidden="true"
        tabindex="-1"
        class="pointer-events-none absolute inset-0 -z-10 size-full object-cover opacity-15 mix-blend-multiply"
      ></video>
      <SectionHeader
        eyebrow="International patients"
        eyebrowClass="bg-white/70"
        highlightClass="text-brand-700"
        leadClass="text-ink-900/85"
        title="International patient services "
        highlight="in Bangalore"
        lead="Travelling from abroad? Here's your journey with us. Our medical travel team supports international patients at every stage of treatment in Bangalore."
      />

      <div class="section-body relative">
        <div aria-hidden="true" class="absolute inset-x-[12%] top-7 hidden h-0.5 bg-brand-200 sm:block"></div>
        <ol role="tablist" aria-label="International patient journey" class="relative grid grid-cols-2 gap-6 sm:grid-cols-4">
          {
            INTERNATIONAL.map((s, i) => (
              <li>
                <button
                  type="button"
                  role="tab"
                  aria-controls="intl-panel"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  data-stage={i}
                  class="group flex w-full flex-col items-center text-center"
                >
                  <span class="grid size-14 place-items-center rounded-full border border-brand-200 bg-white text-ink-900 transition group-hover:scale-105 group-aria-selected:border-transparent group-aria-selected:bg-amber-400 group-aria-selected:ring-8 group-aria-selected:ring-amber-400/25">
                    <img src={s.image} alt={altFor(s.image, `${s.label} icon`)} width="256" height="256" loading="lazy" decoding="async" class="size-10" />
                  </span>
                  <span class="text-kicker mt-4 text-brand-700">Stage {i + 1}</span>
                  <span class="heading-5 mt-1">{s.label}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-5 lg:grid-cols-[1.4fr_1fr]">
        <div id="intl-panel" role="tabpanel" aria-live="polite" class="card bg-white sm:p-8">
          <p class="text-kicker text-ink-900/60" data-intl-label>
            Stage 1 · {first.label}
          </p>
          <h3 class="heading-3 mt-3" data-intl-heading>{first.heading}</h3>
          <ul class="text-body mt-5 space-y-3 sm:text-base" data-intl-points>
            {
              first.points.map((p) => (
                <li class="flex gap-3">
                  <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" /> {p}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card flex flex-col bg-ink-900 text-white sm:p-8">
          <h3 class="heading-3">Talk to our international desk</h3>
          <p class="mt-2 text-sm text-white/70">
            Share your reports and we'll send a treatment plan and cost estimate before you travel.
          </p>
          <div class="mt-auto space-y-3 pt-6">
            <a href="#book" class="btn btn-primary w-full">
              Plan my treatment
            </a>
            <a
              href={`mailto:${SITE.email}`}
              class="block truncate rounded-full border border-white/25 px-4 py-3.5 text-center text-sm font-semibold transition hover:bg-white/10"
            >
              <span class="sm:hidden">Email our desk</span><span class="hidden sm:inline">Email {SITE.email}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ stages: INTERNATIONAL }}>
  // Background video: pick the landscape or portrait file for the screen, load it only when
  // the section comes near, play while visible, pause when scrolled away.
  const video = document.querySelector('[data-intl-video]');
  if (video) {
    const wide = matchMedia('(min-width: 768px)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    const pick = () => {
      const src = wide.matches ? video.dataset.srcWide : video.dataset.srcTall;
      if (video.getAttribute('src') === src) return;
      video.src = src;
      video.preload = 'auto';
      if (visible && !still.matches) video.play().catch(() => {});
    };
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (!visible) return video.pause();
        pick();
        if (!still.matches) video.play().catch(() => {});
      },
      { rootMargin: '200px 0px' },
    ).observe(video);
    wide.addEventListener('change', () => video.getAttribute('src') && pick());
  }

  const root = document.querySelector('[data-intl]');
  const tabs = root.querySelectorAll('[data-stage]');
  const label = root.querySelector('[data-intl-label]');
  const heading = root.querySelector('[data-intl-heading]');
  const list = root.querySelector('[data-intl-points]');
  const template = list.firstElementChild.cloneNode(true);
  const panel = root.querySelector('#intl-panel');

  // Desktop autoplay: move to the next step every few seconds, looping forever. Pauses while the
  // pointer is over a step (its icon or labels) or the content card (not the whole section or row,
  // where the cursor rests while reading), while keyboard focus is inside, while the section is out of view or the
  // browser tab is hidden. Off below 1024px, where the steps are tapped.
  const autoplay = (region, hoverTargets, next) => {
    const DELAY = 4000;
    const desktop = window.matchMedia('(min-width: 1024px)');
    let timer = 0;
    let hovering = false;
    let focused = false;
    let visible = false;
    const stop = () => clearInterval(timer);
    const start = () => {
      stop();
      if (desktop.matches && visible && !hovering && !focused && !document.hidden) {
        timer = setInterval(next, DELAY);
      }
    };
    hoverTargets.forEach((el) => {
      el.addEventListener('mouseenter', () => { hovering = true; stop(); });
      el.addEventListener('mouseleave', () => { hovering = false; start(); });
    });
    // Keyboard focus pauses too (a mouse click focuses the button but shouldn't hold the pause)
    region.addEventListener('focusin', (e) => {
      if (!e.target.matches(':focus-visible')) return;
      focused = true;
      stop();
    });
    region.addEventListener('focusout', (e) => {
      if (region.contains(e.relatedTarget)) return;
      focused = false;
      start();
    });
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; start(); }, { threshold: 0.2 }).observe(region);
    document.addEventListener('visibilitychange', start);
    desktop.addEventListener('change', start);
    // A manual choice restarts the countdown from the step picked
    return { restart: start };
  };

  // auto: chosen by the autoplay (no screen-reader announcement)
  const show = (tab, auto = false) => {
    const i = Number(tab.dataset.stage);
    const s = stages[i];
    panel.setAttribute('aria-live', auto ? 'off' : 'polite');
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    label.textContent = `Stage ${i + 1} · ${s.label}`;
    heading.textContent = s.heading;
    list.replaceChildren(
      ...s.points.map((p) => {
        const li = template.cloneNode(true);
        li.lastChild.textContent = ` ${p}`;
        return li;
      }),
    );
  };

  const current = () => [...tabs].findIndex((t) => t.getAttribute('aria-selected') === 'true');
  // Hover pause: each stage's icon and labels, and the content card
  const loop = autoplay(root, [...[...tabs].flatMap((t) => [...t.children]), panel], () => show(tabs[(current() + 1) % tabs.length], true));

  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      show(tab);
      loop.restart();
    }),
  );
</script>
