---
import Icon from './Icon.astro';
import type { BlogPost } from '../data/blog';

interface Props {
  post: BlogPost;
  index?: number;
  as?: 'h2' | 'h3';
}

const { post: p, index = 0, as: Heading = 'h3' } = Astro.props;
// Shown while an article has no cover photo
const fallbacks = ['from-brand-300 to-brand-600', 'from-teal-400 to-teal-700', 'from-cream-100 to-amber-300'];
---

<a href={`/blog/${p.slug}`} class="group block">
  <div class:list={['relative aspect-[16/10] overflow-hidden rounded-3xl bg-gradient-to-br', fallbacks[index % fallbacks.length]]}>
    <img
      src={p.image}
      alt=""
      loading="lazy"
      class="size-full object-cover transition duration-500 group-hover:scale-105"
      onerror="this.remove()"
    />
    <span class="text-kicker absolute left-4 top-4 rounded-full bg-white px-3 py-1">{p.tag}</span>
  </div>
  <p class="text-meta mt-4">{p.readMinutes} min read</p>
  <Heading class="heading-4 mt-1 transition group-hover:text-brand-600">{p.title}</Heading>
  <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-brand-600">
    Read article <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
  </span>
</a>
