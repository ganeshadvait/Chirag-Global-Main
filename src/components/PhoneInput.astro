---
// Phone field with a country-code picker. Typing a number that starts with + or 00
// switches the country automatically (e.g. "+44 7911…" selects UK and keeps "7911…").
// Submits the full international number through a hidden input named `name`.
import Icon from './Icon.astro';

interface Props {
  name: string;
  label: string;
  placeholder?: string;
  required?: boolean;
  /** 'input' = single box, label hidden (stacked forms) · 'field' = small label inside the box above the number (hero bar) */
  variant?: 'input' | 'field';
  class?: string;
}

const { name, label, placeholder = 'Phone Number', required = false, variant = 'input', class: className } = Astro.props;
const uid = `phone-${name}-${Math.random().toString(36).slice(2, 8)}`;

// Countries our patients most often call from. min/max = digits in the national number.
const COUNTRIES = [
  { iso: 'IN', name: 'India', code: '91', min: 10, max: 10 },
  { iso: 'AE', name: 'United Arab Emirates', code: '971', min: 8, max: 9 },
  { iso: 'SA', name: 'Saudi Arabia', code: '966', min: 9, max: 9 },
  { iso: 'OM', name: 'Oman', code: '968', min: 8, max: 8 },
  { iso: 'QA', name: 'Qatar', code: '974', min: 8, max: 8 },
  { iso: 'KW', name: 'Kuwait', code: '965', min: 8, max: 8 },
  { iso: 'BH', name: 'Bahrain', code: '973', min: 8, max: 8 },
  { iso: 'US', name: 'United States / Canada', code: '1', min: 10, max: 10 },
  { iso: 'GB', name: 'United Kingdom', code: '44', min: 10, max: 10 },
  { iso: 'AU', name: 'Australia', code: '61', min: 9, max: 9 },
  { iso: 'NZ', name: 'New Zealand', code: '64', min: 8, max: 10 },
  { iso: 'SG', name: 'Singapore', code: '65', min: 8, max: 8 },
  { iso: 'MY', name: 'Malaysia', code: '60', min: 9, max: 10 },
  { iso: 'LK', name: 'Sri Lanka', code: '94', min: 9, max: 9 },
  { iso: 'NP', name: 'Nepal', code: '977', min: 10, max: 10 },
  { iso: 'BD', name: 'Bangladesh', code: '880', min: 10, max: 10 },
  { iso: 'MV', name: 'Maldives', code: '960', min: 7, max: 7 },
  { iso: 'KE', name: 'Kenya', code: '254', min: 9, max: 9 },
  { iso: 'NG', name: 'Nigeria', code: '234', min: 10, max: 10 },
  { iso: 'TZ', name: 'Tanzania', code: '255', min: 9, max: 9 },
  { iso: 'DE', name: 'Germany', code: '49', min: 10, max: 11 },
  { iso: 'FR', name: 'France', code: '33', min: 9, max: 9 },
];
---

<div class:list={['relative', className]} data-phone data-countries={JSON.stringify(COUNTRIES)}>
  <input type="hidden" name={name} />
  <div
    class:list={[
      'ring-brand-400 transition focus-within:ring-2 hover:bg-brand-100',
      variant === 'field' ? 'h-full rounded-2xl bg-brand-50 px-5 py-3.5' : 'flex rounded-xl bg-brand-50',
    ]}
  >
    {variant === 'field' && <label for={uid} class="block text-[0.6875rem] font-semibold uppercase tracking-wider text-brand-700">{label}</label>}
    <div class:list={['flex', variant === 'field' && 'mt-1 items-center']}>
      <button
        type="button"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls={`${uid}-list`}
        aria-label="Country code"
        data-phone-trigger
        class:list={[
          'flex shrink-0 cursor-pointer items-center gap-1 border-r border-brand-200/70 font-medium text-ink-900 outline-none transition hover:text-brand-700',
          variant === 'field'
            ? 'rounded-md pr-2 text-[0.9375rem] focus-visible:ring-2'
            : 'rounded-l-xl py-3.5 pl-3.5 pr-2 focus-visible:bg-brand-100 min-[360px]:pl-4 min-[360px]:pr-2.5',
        ]}
      >
        <span data-phone-code>+91</span>
        <Icon name="chevronDown" class="size-3.5 text-brand-700" />
      </button>
      <input
        id={uid}
        type="tel"
        inputmode="tel"
        autocomplete="tel-national"
        required={required}
        placeholder={placeholder}
        aria-label={variant === 'field' ? undefined : label}
        data-phone-input
        class:list={[
          'w-full min-w-0 bg-transparent outline-none',
          variant === 'field'
            ? 'pl-2.5 text-[0.9375rem] text-ink-900 placeholder:text-ink-900/45'
            : 'py-3.5 pl-2.5 pr-3 placeholder:text-ink-900/55 min-[360px]:pl-3 min-[360px]:pr-4',
        ]}
      />
    </div>
  </div>

  <ul
    id={`${uid}-list`}
    role="listbox"
    tabindex="-1"
    aria-label="Country code"
    hidden
    data-phone-list
    class="absolute inset-x-0 top-full z-40 mt-2 max-h-72 overflow-y-auto overscroll-contain rounded-2xl bg-white p-1.5 text-ink-900 shadow-2xl shadow-ink-900/20 ring-1 ring-brand-100 outline-none sm:right-auto sm:w-72"
  >
    {
      COUNTRIES.map((c, i) => (
        <li
          role="option"
          id={`${uid}-${c.iso}`}
          data-index={i}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="group flex cursor-pointer items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition hover:bg-brand-50 data-[active]:bg-brand-50 aria-selected:text-brand-700"
        >
          <span class="w-7 shrink-0 text-xs font-semibold text-brand-400">{c.iso}</span>
          <span class="flex-1 truncate">{c.name}</span>
          <span class="text-ink-900/60">+{c.code}</span>
          <Icon name="check" class="size-4 shrink-0 text-brand-600 opacity-0 group-aria-selected:opacity-100" />
        </li>
      ))
    }
  </ul>
</div>

<script>
  interface Country {
    iso: string;
    name: string;
    code: string;
    min: number;
    max: number;
  }

  document.querySelectorAll<HTMLElement>('[data-phone]').forEach((root) => {
    const countries: Country[] = JSON.parse(root.dataset.countries!);
    const hidden = root.querySelector<HTMLInputElement>('input[type=hidden]')!;
    const input = root.querySelector<HTMLInputElement>('[data-phone-input]')!;
    const trigger = root.querySelector<HTMLButtonElement>('[data-phone-trigger]')!;
    const codeEl = root.querySelector<HTMLElement>('[data-phone-code]')!;
    const list = root.querySelector<HTMLElement>('[data-phone-list]')!;
    const items = [...list.querySelectorAll<HTMLElement>('[role=option]')];
    // Longest codes first, so "+971" matches UAE rather than "+9…" something shorter
    const byCode = [...countries].sort((a, b) => b.code.length - a.code.length);
    let current = 0;
    let active = 0;

    const sync = () => {
      const c = countries[current];
      const digits = input.value.replace(/\D/g, '').replace(/^0+/, ''); // drop a leading trunk 0 (e.g. UK 07911…)
      hidden.value = digits ? `+${c.code} ${digits}` : '';
      const lengthOk = digits.length >= c.min && digits.length <= c.max;
      const startOk = c.iso !== 'IN' || /^[6-9]/.test(digits);
      input.setCustomValidity(
        !digits || (lengthOk && startOk)
          ? ''
          : !lengthOk
            ? `Please enter a valid ${c.name} number (${c.min === c.max ? c.min : `${c.min}–${c.max}`} digits after +${c.code}).`
            : 'Indian mobile numbers start with 6, 7, 8 or 9.',
      );
    };

    const setCountry = (i: number) => {
      current = i;
      codeEl.textContent = `+${countries[i].code}`;
      trigger.setAttribute('aria-label', `Country code: ${countries[i].name} +${countries[i].code}`);
      items.forEach((el, n) => el.setAttribute('aria-selected', String(n === i)));
      sync();
    };

    // Typing or pasting "+44…" / "0044…" picks the country and keeps only the national number
    input.addEventListener('input', () => {
      const m = input.value.match(/^\s*(?:\+|00)\s*([\d\s-]+)/);
      if (m) {
        const digits = m[1].replace(/\D/g, '');
        const c = byCode.find((c) => digits.startsWith(c.code) && digits.length > c.code.length);
        if (c) {
          setCountry(countries.indexOf(c));
          // Remove just the prefix and code, keeping the person's own spacing in the rest
          input.value = input.value.replace(new RegExp(`^\\s*(?:\\+|00)\\s*${c.code.split('').join('[\\s-]*')}[\\s-]*`), '');
        }
      }
      sync();
    });

    const setActive = (i: number) => {
      active = (i + items.length) % items.length;
      items.forEach((el, n) => el.toggleAttribute('data-active', n === active));
      items[active].scrollIntoView({ block: 'nearest' });
      trigger.setAttribute('aria-activedescendant', items[active].id);
    };
    const open = () => {
      if (!list.hidden) return;
      list.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      setActive(current);
    };
    const close = (focus = true) => {
      if (list.hidden) return;
      list.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      trigger.removeAttribute('aria-activedescendant');
      if (focus) trigger.focus();
    };
    const choose = (i: number) => {
      setCountry(i);
      close(false);
      input.focus();
    };

    trigger.addEventListener('click', () => (list.hidden ? open() : close()));
    items.forEach((el, i) => {
      el.addEventListener('mousemove', () => active !== i && setActive(i));
      el.addEventListener('click', () => choose(i));
    });
    trigger.addEventListener('keydown', (e) => {
      const isOpen = !list.hidden;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!isOpen) open();
        else setActive(active + (e.key === 'ArrowDown' ? 1 : -1));
      } else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (isOpen) choose(active);
        else open();
      } else if (e.key === 'Escape' && isOpen) {
        e.preventDefault();
        close();
      } else if (e.key === 'Tab') {
        close(false);
      } else if (isOpen && e.key.length === 1) {
        // Type-ahead by country name
        const i = countries.findIndex((c) => c.name.toLowerCase().startsWith(e.key.toLowerCase()));
        if (i >= 0) setActive(i);
      }
    });
    document.addEventListener('pointerdown', (e) => {
      if (!root.contains(e.target as Node)) close(false);
    });

    root.closest('form')?.addEventListener('reset', () => setTimeout(() => setCountry(0)));
  });
</script>
