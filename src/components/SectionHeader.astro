---
// Standard section heading: eyebrow label → h2 → optional lead paragraph,
// with an optional action (e.g. "All treatments") aligned to the right.
interface Props {
  eyebrow: string;
  title: string;
  /** Trailing words shown in the brand gradient */
  highlight?: string;
  lead?: string;
  align?: 'left' | 'center';
  /** Light text for dark panels */
  tone?: 'default' | 'dark';
  /** Extra classes for the eyebrow chip (e.g. a translucent background on tinted panels) */
  eyebrowClass?: string;
  id?: string;
}

const { eyebrow, title, highlight, lead, align = 'left', tone = 'default', eyebrowClass, id } = Astro.props;
const hasAction = Astro.slots.has('action');
const dark = tone === 'dark';
---

<div
  class:list={[
    'flex flex-col gap-6',
    align === 'center' ? 'items-center text-center' : hasAction && 'sm:flex-row sm:items-end sm:justify-between',
  ]}
>
  <div class:list={['max-w-2xl', align === 'center' && 'mx-auto']}>
    <span class:list={['eyebrow', dark && 'bg-white/10 text-amber-400', eyebrowClass]}>{eyebrow}</span>
    <h2 id={id} class:list={['heading-2 mt-4', dark && 'text-white']}>
      {title}
      {highlight && <span class={dark ? 'text-amber-400' : 'text-gradient-brand'}>{highlight}</span>}
    </h2>
    {lead && <p class:list={['text-lead mt-4', dark && 'text-white/75']}>{lead}</p>}
  </div>
  {hasAction && <div class="shrink-0"><slot name="action" /></div>}
</div>
