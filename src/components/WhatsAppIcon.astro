---
// Official WhatsApp mark. Gradient ids are made unique per instance: the icon is
// rendered in both the desktop and mobile contact bars, and one of them is always
// display:none — a gradient defined inside a hidden SVG stops painting elsewhere.
interface Props {
  class?: string;
}

const { class: className = 'size-6' } = Astro.props;
const id = Math.random().toString(36).slice(2, 8);
