---
import Icon from './Icon.astro';
import { CATEGORY_ICONS, eventDay, formatEventDate, type HospitalEvent } from '../data/events';

interface Props {
  event: HospitalEvent;
  as?: 'h2' | 'h3' | 'h4';
}

const { event: e, as: Heading = 'h3' } = Astro.props;
const d = eventDay(e.date);
---

<a href={`/about/events/${e.slug}`} class="group flex h-full flex-col overflow-hidden rounded-3xl bg-white ring-1 ring-brand-100 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-200/50">
  <div class="relative aspect-[16/10] overflow-hidden bg-brand-100">
    <img src={e.cover} alt="" loading="lazy" class="size-full object-cover transition duration-500 group-hover:scale-105" />
    <div class="absolute left-4 top-4 grid min-w-14 place-content-center rounded-2xl bg-white px-3 py-2 text-center shadow-lg">
      <span class="text-xl font-extrabold leading-none text-ink-900">{d.day}</span>
      <span class="text-kicker mt-1 text-brand-500">{d.month}</span>
    </div>
    <span class="absolute bottom-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-ink-900/80 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur">
      <Icon name={CATEGORY_ICONS[e.category]} class="size-3.5 text-amber-400" />
      {e.category}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-meta">{formatEventDate(e)}</p>
    <Heading class="heading-4 mt-1.5 group-hover:text-brand-700">{e.title}</Heading>
    <p class="text-body mt-2">{e.excerpt}</p>
    <p class="text-meta mt-4 flex items-start gap-1.5">
      <Icon name="pin" class="mt-0.5 size-3.5 shrink-0 text-brand-500" />
      {e.venue}
    </p>
    <span class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold text-brand-600">
      View event <Icon name="arrowRight" class="size-4 transition group-hover:translate-x-1" />
    </span>
  </div>
</a>
