---
import { SITE, digits } from '../config';
import { TREATMENTS_LIST } from '../data/treatments';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const treatments = TREATMENTS_LIST.slice(0, 5).map((t) => ({ label: t.name, href: `/treatments/${t.slug}` }));

const hospital = [
  { label: 'About us', href: '/about' },
  { label: 'Our doctors', href: '/doctors' },
  { label: 'Advanced technologies', href: '/about/advanced-technologies' },
  { label: 'Patient stories', href: '/#stories' },
  { label: 'Blog', href: '/blog' },
  { label: 'International patients', href: '/#international' },
];

const social = [
  { icon: 'facebook', href: SITE.social.facebook, label: 'Facebook' },
  { icon: 'instagram', href: SITE.social.instagram, label: 'Instagram' },
  { icon: 'youtube', href: SITE.social.youtube, label: 'YouTube' },
  { icon: 'linkedin', href: SITE.social.linkedin, label: 'LinkedIn' },
] as const;
---

<footer class="relative overflow-hidden bg-gradient-to-br from-ink-800 via-ink-700 to-brand-700 text-white">
  <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 size-80 rounded-full bg-amber-400/15 blur-3xl"></div>

  <div class="container-x relative py-14 lg:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1.3fr]">
      <div>
        <Logo />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/75">
          Colorectal and proctology care in Bengaluru since 1986. {SITE.accreditation}.
        </p>
        <ul class="mt-6 flex gap-3">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.href}
                  aria-label={s.label}
                  class="grid size-9 place-items-center rounded-full bg-white/10 transition hover:bg-white/20"
                >
                  <Icon name={s.icon} class="size-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="heading-5 text-white">Treatments</h2>
        <ul class="mt-4 space-y-3 text-sm text-white/75">
          {treatments.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
          <li><a href="/treatments" class="font-semibold text-amber-400 hover:text-amber-300">All {TREATMENTS_LIST.length} conditions</a></li>
        </ul>
      </div>

      <div>
        <h2 class="heading-5 text-white">Hospital</h2>
        <ul class="mt-4 space-y-3 text-sm text-white/75">
          {hospital.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2 class="heading-5 text-white">Contact and hours</h2>
        <ul class="mt-4 space-y-3 text-sm text-white/75">
          <li class="leading-relaxed">{SITE.address}</li>
          <li><a href={`tel:${digits(SITE.phone)}`} class="font-semibold text-white">{SITE.phone}</a></li>
          <li><a href={`mailto:${SITE.email}`} class="break-all hover:text-white">{SITE.email}</a></li>
          <li>Mon to Sat {SITE.hours.weekdays}<br />Sunday {SITE.hours.sunday}</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/15 pt-6 text-xs text-white/70 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <p class="flex flex-wrap gap-x-2">
        <a href="/privacy-policy" class="underline hover:text-white">Privacy policy</a> ·
        <a href="/cookie-policy" class="underline hover:text-white">Cookie policy</a> ·
        <a href="/medical-disclaimer" class="underline hover:text-white">Medical disclaimer</a>
      </p>
    </div>
  </div>
</footer>
