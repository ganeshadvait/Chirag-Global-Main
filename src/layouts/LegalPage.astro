---
// Shared shell for policy pages: page hero + readable single column of prose.
import Layout from './Layout.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={title} description={description} booking={false}>
  <PageHero crumbs={[{ label: title }]} eyebrow="Legal" title={title} lead={`Last updated ${updated}`} />
  <section class="section">
    <div
      class="container-x max-w-3xl text-base leading-relaxed text-ink-900/80 [&_a]:font-medium [&_a]:text-brand-700 [&_a]:underline [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:leading-snug sm:[&_h2]:text-2xl [&_h2]:text-ink-900 [&_li]:mt-2 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6"
    >
      <slot />
    </div>
  </section>
</Layout>
