---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import BookCta from '../components/home/BookCta.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** Let the header float over a full-bleed hero */
  overlayHeader?: boolean;
  /** Show the "Book your visit" section above the footer (default true) */
  booking?: boolean;
  /** Add a map card beside the booking section */
  bookingMap?: boolean;
}

const { title, description = SITE.description, overlayHeader = false, booking = true, bookingMap = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#231b3f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden bg-white pb-[calc(4rem+env(safe-area-inset-bottom))] text-ink-900 antialiased lg:pb-0">
    <Header overlay={overlayHeader} bookHref={booking ? '#book' : '/contact#book'} />
    <main class="flex-1">
      <slot />
      {booking && <BookCta withMap={bookingMap} />}
    </main>
    <Footer />
    <FloatingActions />
  </body>
</html>
