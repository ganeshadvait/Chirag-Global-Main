---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
import BookCta from '../components/home/BookCta.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  /** Complete <title> used exactly as given (no " | Chirag Global Hospitals" suffix), e.g. an SEO meta title */
  metaTitle?: string;
  description?: string;
  /** Primary SEO keyword(s) for the page */
  keywords?: string;
  /** Let the header float over a full-bleed hero */
  overlayHeader?: boolean;
  /** Show the "Book your visit" section above the footer (default true) */
  booking?: boolean;
  /** Add a map card beside the booking section */
  bookingMap?: boolean;
}

const { title, metaTitle, description = SITE.description, keywords, overlayHeader = false, booking = true, bookingMap = false } = Astro.props;
const pageTitle = metaTitle ?? (title ? `${title} | ${SITE.name}` : SITE.name);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#231b3f" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Inter as one variable font, loaded without blocking the first paint
         (text shows in the metric-matched fallback until it arrives) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..900&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400..900&display=swap" />
    </noscript>
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden bg-white pb-[calc(4rem+env(safe-area-inset-bottom))] text-ink-900 antialiased lg:pb-0">
    <Header overlay={overlayHeader} bookHref={booking ? '#book' : '/contact#book'} />
    <main class="flex-1">
      <slot />
      {booking && <BookCta withMap={bookingMap} />}
    </main>
    <Footer />
    <FloatingActions />
  </body>
</html>
